generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  content     String
  coverImage  String?
  category    String   @default("Geral")
  author      String   @default("área reversa")
  tags        String[] @default([])
  published   Boolean  @default(false)
  publishAt   DateTime?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  searchVector String?  @db.Text // tsvector for full-text search
  readingMinutes Int?   // calculado por trigger no banco (evita enviar o post inteiro só para contar palavras)

  // Traduções. Nulo = ainda não traduzido, e a página cai no texto em português.
  titleEn   String? @map("title_en")
  excerptEn String? @map("excerpt_en") @default("")
  contentEn String? @map("content_en")
  titleEs   String? @map("title_es")
  excerptEs String? @map("excerpt_es") @default("")
  contentEs String? @map("content_es")

  comments    Comment[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  name      String
  text      String
  hidden    Boolean  @default(false)
  adminReply String?
  createdAt DateTime @default(now())

  @@map("comments")
}

model Event {
  id        String   @id @default(cuid())
  type      String   // "pageview" | "click" | "vital"
  path      String
  target    String?
  device    String   // "desktop" | "mobile" | "tablet"
  referrer  String?
  ip        String?
  country   String?
  city      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([ip])
  @@map("events")
}

model EmailSubscriber {
  id                String   @id @default(cuid())
  email             String   @unique
  confirmed         Boolean  @default(false)
  token             String?  @unique
  tokenExpiresAt    DateTime?
  confirmedAt       DateTime?
  unsubscribeToken  String?  @unique
  unsubscribedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("email_subscribers")
}

model Setting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}

model Webmention {
  id          String   @id @default(cuid())
  source      String
  target      String
  postSlug    String?
  type        String   @default("mention")
  title       String?
  authorName  String?
  authorUrl   String?
  authorPhoto String?
  content     String?
  published   String?
  status      String   @default("pending")
  adminReply  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, target])
  @@index([postSlug])
  @@index([status])
  @@index([createdAt])
  @@map("webmentions")
}