# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# backups do banco (contem dados de produção, nunca vao para o git)
backups/
.tmp-backup-test/

# arquivos temporarios
tmp_*.cjs
tmp_*.mjs

# rascunho de conteudo: a fonte unica do artigo e o banco de producao (Neon),
# que tem backup diario. Versionar uma copia em .md aqui criaria uma segunda
# versao que diverge em silencio quando o post for editado pelo /admin.
conteudo-*.md
